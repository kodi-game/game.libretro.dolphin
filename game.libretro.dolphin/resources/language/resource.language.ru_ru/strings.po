msgctxt "#30482"
msgid "WiiMote IR > Modifier Button"
msgstr "ИК-указатель Wii Remote > Кнопка-модификатор"

msgctxt "#30483"
msgid "Button used as a modifier for IR control. With no modifier selected, IR is always active with right thumbstick."
msgstr "Кнопка, используемая как модификатор для управления ИК-указателем. Если модификатор не выбран, ИК-указатель всегда активен при использовании правого стика."

msgctxt "#30484"
