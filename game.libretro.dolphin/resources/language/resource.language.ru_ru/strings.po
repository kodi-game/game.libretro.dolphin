msgid "Start"
msgstr "Start"

msgctxt "#30142"
msgid "Select"
msgstr "Выбрать"

msgctxt "#30143"
msgid "System Configuration - Wii"
msgstr "Конфигурация системы — Wii"

msgctxt "#30144"
msgid "Configure Wii system settings."
msgstr "Настройка системных параметров Wii."

msgctxt "#30145"
msgid "System Configuration > Widescreen (Wii)"
msgstr "Конфигурация системы > Широкоэкранный режим (Wii)"

msgctxt "#30146"
msgid "Enable widescreen for Wii."
msgstr "Включить широкоэкранный режим для Wii."

msgctxt "#30147"
msgid "System Configuration > Progressive Scan"
msgstr "Конфигурация системы > Прогрессивная развёртка"

msgctxt "#30148"
msgid "Enable progressive scan."
msgstr "Включить прогрессивную развёртку."

msgctxt "#30149"
msgid "System Configuration > PAL60 Mode"
msgstr "Конфигурация системы > Режим PAL60"

msgctxt "#30150"
msgid "Enable 60Hz for PAL games."
msgstr "Включить 60 Гц для игр PAL."

msgctxt "#30151"
msgid "System Configuration > Sensor Bar Position"
msgstr "Конфигурация системы > Положение сенсорной панели"

msgctxt "#30152"
msgid "Set Wiimote sensor bar position."
msgstr "Задать положение сенсорной панели Wiimote."

msgctxt "#30153"
msgid "Bottom"
msgstr "Снизу"

msgctxt "#30154"
msgid "Top"
msgstr "Сверху"

msgctxt "#30155"
msgid "System Configuration > Controller Rumble"
msgstr "Конфигурация системы > Вибрация контроллера"

msgctxt "#30156"
msgid "Enable rumble feedback."
msgstr "Включить вибрацию."

msgctxt "#30157"
msgid "System Configuration > Wiimote Continuous Scanning"
msgstr "Конфигурация системы > Непрерывное сканирование Wiimote"

msgctxt "#30158"
msgid "Continuously scan for Wiimotes."
msgstr "Непрерывно искать Wiimote."

msgctxt "#30159"
msgid "System Configuration > Alt GC Ports (Wii)"
msgstr "Конфигурация системы > Альтернативные порты GC (Wii)"

msgctxt "#30160"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Использовать порты 5–8 для контроллеров GameCube в режиме Wii."

msgctxt "#30161"
msgid "System Configuration > Bluetooth passthrough mode"
msgstr "Конфигурация системы > Режим сквозной передачи Bluetooth"

msgctxt "#30162"
msgid "Pass all traffic directly to the host's Bluetooth adapter. Press F12 to begin the sync process."
msgstr "Передавать весь трафик напрямую в Bluetooth-адаптер хоста. Нажмите F12 для начала процесса синхронизации."

msgctxt "#30163"
msgid "System Configuration > Wii Speak"
msgstr "Конфигурация системы > Wii Speak"

msgctxt "#30164"
msgid "Emulate the Wii Speak microphone. Restart when changing this option."
msgstr "Эмулировать микрофон Wii Speak. Перезапустите при изменении этого параметра."

msgctxt "#30165"
msgid "Audio > Devices > Wii Speak Muted"
msgstr "Аудио > Устройства > Wii Speak без звука"

msgctxt "#30166"
msgid "Mute or unmute the Wii Speak microphone."
msgstr "Включить или отключить звук микрофона Wii Speak."

msgctxt "#30167"
msgid "System Configuration > Logitech USB Microphone"
msgstr "Конфигурация системы > USB-микрофон Logitech"

msgctxt "#30168"
msgid "Emulate the Logitech USB microphone. Restart when changing this option."
msgstr "Эмулировать USB-микрофон Logitech. Перезапустите при изменении этого параметра."

msgctxt "#30169"
msgid "Graphics > Settings"
msgstr "Графика > Настройки"

msgctxt "#30170"
msgid "Configure rendering backend and quality settings."
msgstr "Настройка бэкенда отрисовки и параметров качества."

msgctxt "#30171"
msgid "Graphics > Settings > Graphics Backend"
msgstr "Графика > Настройки > Бэкенд графики"

msgctxt "#30172"
msgid "Select rendering backend."
msgstr "Выберите бэкенд отрисовки."

msgctxt "#30173"
msgid "Hardware"
msgstr "Аппаратный"

msgctxt "#30174"
msgid "Graphics > Settings > Widescreen Hack"
msgstr "Графика > Настройки > Хак широкоэкранного режима"

msgctxt "#30175"
msgid "Force 16:9 rendering."
msgstr "Принудительно отрисовывать в 16:9."

msgctxt "#30176"
msgid "Graphics > Settings > Aspect Ratio"
msgstr "Графика > Настройки > Соотношение сторон"

msgctxt "#30177"
msgid "Control how the game's image is scaled."
msgstr "Управлять масштабированием изображения игры."

msgctxt "#30178"
msgid "Auto"
msgstr "Авто"

msgctxt "#30179"
msgid "Force Wide"
msgstr "Принудительно широкий"

msgctxt "#30180"
msgid "Force Standard"
msgstr "Принудительно стандартный"

msgctxt "#30181"
msgid "Stretch"
msgstr "Растянуть"

msgctxt "#30182"
msgid "Custom"
msgstr "Ручная настройка"

msgctxt "#30183"
msgid "Custom Stretch"
msgstr "Настраиваемое растяжение"

msgctxt "#30184"
msgid "Raw"
msgstr "Необработанный"

msgctxt "#30185"
msgid "Graphics > Settings > Crop Overscan"
msgstr "Графика > Настройки > Обрезать вылеты развёртки"

msgctxt "#30186"
msgid "Report standard TV output resolution to the frontend (NTSC: 480, PAL: 576). Recommended for CRT displays with SwitchRes."
msgstr "Сообщать фронтенду стандартное разрешение телевизионного вывода (NTSC: 480, PAL: 576). Рекомендуется для ЭЛТ-дисплеев со SwitchRes."

