msgstr "Встроенный Ethernet"

msgctxt "#30124"
msgid "Ethernet IPC"
msgstr "Ethernet IPC"

msgctxt "#30125"
msgid "Modem TapServer"
msgstr "Модем TapServer"

msgctxt "#30126"
msgid "Baseboard"
msgstr "Системная плата"

msgctxt "#30127"
msgid "System Configuration (GC) > GameCube Microphone"
msgstr "Конфигурация системы (GC) > Микрофон GameCube"

msgctxt "#30128"
msgid "Emulate the official GameCube microphone accessory. Restart core after changing this option."
msgstr "Эмулировать официальный аксессуар-микрофон GameCube. Перезапустите ядро после изменения этого параметра."

msgctxt "#30129"
msgid "System Configuration (GC) > Microphone Button"
msgstr "Конфигурация системы (GC) > Кнопка микрофона"

msgctxt "#30130"
msgid "Button to hold or press to activate the microphone input. Selecting OFF disables microphone activation."
msgstr "Кнопка для удержания или нажатия для активации входа микрофона. Выбор «ОТКЛ» отключает активацию микрофона."

