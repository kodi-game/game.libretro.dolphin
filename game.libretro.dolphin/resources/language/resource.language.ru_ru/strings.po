msgid "Graphics > Settings > Fast Depth Calculation"
msgstr "Графика > Настройки > Быстрый расчёт глубины"

msgctxt "#30227"
msgid "Use faster depth calculation."
msgstr "Использовать более быстрый расчёт глубины."

msgctxt "#30228"
msgid "Graphics > Settings > Disable Fog"
msgstr "Графика > Настройки > Отключить туман"

msgctxt "#30229"
msgid "Disable fog rendering effects. May improve performance but reduces visual accuracy."
msgstr "Отключить эффекты отрисовки тумана. Может повысить производительность, но снижает визуальную точность."

msgctxt "#30230"
msgid "Graphics > Settings > Enable Mods"
msgstr "Графика > Настройки > Включить моды"

msgctxt "#30231"
