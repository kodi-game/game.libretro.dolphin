msgctxt "Addon Summary"
msgid "Nintendo - GameCube / Wii (Dolphin)"
msgstr "Nintendo — GameCube / Wii (Dolphin)"

msgctxt "Addon Description"
msgid "Dolphin is an emulator for two recent Nintendo video game consoles: the GameCube and the Wii."
msgstr "Dolphin — это эмулятор для двух последних игровых консолей Nintendo: GameCube и Wii."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Core"
msgstr "Ядро"

msgctxt "#30002"
msgid "Configure CPU emulation, timing, and core system settings."
msgstr "Настройка эмуляции ЦП, синхронизации и системных параметров ядра."

msgctxt "#30003"
msgid "Core > CPU Core"
msgstr "Ядро > Ядро ЦП"

msgctxt "#30004"
msgid "Select CPU emulation method - JIT provides best performance."
msgstr "Выберите метод эмуляции ЦП — JIT обеспечивает наилучшую производительность."

msgctxt "#30005"
msgid "Interpreter (slowest)"
msgstr "Интерпретатор (самый медленный)"

msgctxt "#30006"
msgid "JIT64 (Recommended)"
msgstr "JIT64 (рекомендуется)"

msgctxt "#30007"
msgid "Cached Interpreter (slower)"
msgstr "Кэширующий интерпретатор (медленнее)"

msgctxt "#30008"
msgid "Core > CPU Clock Rate"
msgstr "Ядро > Тактовая частота ЦП"

msgctxt "#30009"
msgid "Adjust emulated CPU speed."
msgstr "Настроить скорость эмулируемого ЦП."

msgctxt "#30010"
msgid "5%"
msgstr "5 %"

msgctxt "#30011"
msgid "10%"
msgstr "10 %"

msgctxt "#30012"
msgid "20%"
msgstr "20 %"

msgctxt "#30013"
msgid "30%"
msgstr "30 %"

msgctxt "#30014"
msgid "40%"
msgstr "40 %"

msgctxt "#30015"
msgid "50%"
msgstr "50 %"

msgctxt "#30016"
msgid "60%"
msgstr "60 %"

msgctxt "#30017"
msgid "70%"
msgstr "70 %"

msgctxt "#30018"
msgid "80%"
msgstr "80 %"

msgctxt "#30019"
msgid "90%"
msgstr "90 %"

msgctxt "#30020"
msgid "100% (Default)"
msgstr "100 % (по умолчанию)"

msgctxt "#30021"
msgid "150%"
msgstr "150 %"

msgctxt "#30022"
msgid "200%"
msgstr "200 %"

msgctxt "#30023"
msgid "250%"
msgstr "250 %"

msgctxt "#30024"
msgid "300%"
msgstr "300 %"

msgctxt "#30025"
msgid "Core > Emulation Speed"
msgstr "Ядро > Скорость эмуляции"

msgctxt "#30026"
msgid "Set speed limit for emulation."
msgstr "Задать ограничение скорости эмуляции."

msgctxt "#30027"
msgid "100% (Normal Speed)"
msgstr "100 % (обычная скорость)"

msgctxt "#30028"
msgid "Unlimited"
msgstr "Без ограничений"

msgctxt "#30029"
msgid "Core > Dual Core Mode"
msgstr "Ядро > Двухъядерный режим"

msgctxt "#30030"
msgid "Enable dual-core CPU emulation. Requires core RESTART."
msgstr "Включить двухъядерную эмуляцию ЦП. Требуется ПЕРЕЗАПУСК ядра."

msgctxt "#30031"
msgid "Disabled"
msgstr "Отключено"

msgctxt "#30032"
msgid "Enabled"
msgstr "Включено"

msgctxt "#30033"
msgid "Core > Load Whole Game Into Memory"
msgstr "Ядро > Загружать всю игру в память"

msgctxt "#30034"
msgid "Load Whole Game Into Memory. Requires core RESTART."
msgstr "Загружать всю игру в память. Требуется ПЕРЕЗАПУСК ядра."

msgctxt "#30035"
msgid "Core > Precision Frame Timing"
msgstr "Ядро > Точная синхронизация кадров"

msgctxt "#30036"
msgid "Use busy-wait for more accurate frame timing."
msgstr "Использовать активное ожидание для более точной синхронизации кадров."

msgctxt "#30037"
msgid "Core > Fastmem"
msgstr "Ядро > Fastmem"

msgctxt "#30038"
msgid "Enable fastmem optimization - which uses memory mapping for faster access."
msgstr "Включить оптимизацию fastmem — использует отображение памяти для более быстрого доступа."

msgctxt "#30039"
msgid "Core > Fastmem Arena"
msgstr "Ядро > Арена fastmem"

msgctxt "#30040"
msgid "Enable fastmem arena - reserves 12 GiB of virtual memory for super fast access."
msgstr "Включить арену fastmem — резервирует 12 ГиБ виртуальной памяти для сверхбыстрого доступа."

msgctxt "#30041"
msgid "Core > Accurate CPU cache"
msgstr "Ядро > Точный кэш ЦП"

msgctxt "#30042"
msgid "Enabled - fast, Disabled - guarantees correctness involving cache behaviour."
msgstr "Включено — быстро, отключено — гарантирует корректность поведения кэша."

msgctxt "#30043"
msgid "Core > Internal Cheats"
msgstr "Ядро > Встроенные читы"

msgctxt "#30044"
msgid "Enable built-in cheat codes. Restart core to take effect."
msgstr "Включить встроенные коды читов. Перезапустите ядро для применения."

msgctxt "#30045"
msgid "Core > Skip GameCube BIOS"
msgstr "Ядро > Пропускать BIOS GameCube"

msgctxt "#30046"
msgid "Skip the GameCube BIOS animation/menu and start the game directly."
msgstr "Пропускать анимацию/меню BIOS GameCube и запускать игру напрямую."

msgctxt "#30047"
msgid "Core > Disc Based Games Boot to Wii Menu"
msgstr "Ядро > Игры на дисках загружаются в меню Wii"

msgctxt "#30048"
msgid "When a Wii System Menu is installed in the save location and the game is a disc based game, it will start the Wii Menu with the disc inserted in the drive instead of directly booting the game. Beware: The game region must match the Wii Menu region otherwise the game will not be recognized."
msgstr "Когда системное меню Wii установлено в каталоге сохранений и игра распространяется на диске, запускается меню Wii со вставленным в привод диском вместо прямой загрузки игры. Внимание: регион игры должен совпадать с регионом меню Wii, иначе игра не будет распознана."

msgctxt "#30049"
msgid "Core > System Language"
msgstr "Ядро > Язык системы"

msgctxt "#30050"
msgid "Set system language."
msgstr "Задать язык системы."

msgctxt "#30051"
msgid "English"
msgstr "Английский"

msgctxt "#30052"
msgid "Japanese"
msgstr "Японский"

msgctxt "#30053"
msgid "German"
msgstr "Немецкий"

msgctxt "#30054"
msgid "French"
msgstr "Французский"

msgctxt "#30055"
msgid "Spanish"
msgstr "Испанский"

msgctxt "#30056"
msgid "Italian"
msgstr "Итальянский"

msgctxt "#30057"
msgid "Dutch"
msgstr "Голландский"

msgctxt "#30058"
msgid "Simplified Chinese"
msgstr "Китайский (упрощённый)"

msgctxt "#30059"
msgid "Traditional Chinese"
msgstr "Китайский (традиционный)"

msgctxt "#30060"
msgid "Korean"
msgstr "Корейский"

msgctxt "#30061"
msgid "Core > Speed Up Disc Transfer"
msgstr "Ядро > Ускорить передачу с диска"

msgctxt "#30062"
msgid "Reduce loading times."
msgstr "Сократить время загрузки."

msgctxt "#30063"
msgid "Core > Enable MMU"
msgstr "Ядро > Включить MMU"

msgctxt "#30064"
msgid "Enable emulation of the Memory Management Unit."
msgstr "Включить эмуляцию блока управления памятью."

msgctxt "#30065"
msgid "Core > Rush Frame Presentation"
msgstr "Ядро > Ускоренный вывод кадров"

msgctxt "#30066"
msgid "Enable rushing frame presentation for lower latency."
msgstr "Включить ускоренный вывод кадров для меньшей задержки."

msgctxt "#30067"
msgid "Core > Smooth Early Presentation"
msgstr "Ядро > Плавный ранний вывод"

msgctxt "#30068"
msgid "Enable smoother early frame presentation timing."
msgstr "Включить более плавную синхронизацию раннего вывода кадров."

msgctxt "#30069"
msgid "Audio / DSP"
msgstr "Аудио / DSP"

msgctxt "#30070"
msgid "Configure audio output and DSP emulation."
msgstr "Настройка звукового вывода и эмуляции DSP."

msgctxt "#30071"
msgid "Audio / DSP > DSP HLE"
msgstr "Аудио / DSP > DSP HLE"

msgctxt "#30072"
msgid "Choose DSP method - HLE is faster, LLE is more accurate."
msgstr "Выберите метод DSP — HLE быстрее, LLE точнее."

msgctxt "#30073"
msgid "HLE (Fast)"
msgstr "HLE (быстро)"

msgctxt "#30074"
msgid "LLE (Accurate)"
msgstr "LLE (точно)"

msgctxt "#30075"
msgid "Audio / DSP > DSP JIT"
msgstr "Аудио / DSP > JIT для DSP"

msgctxt "#30076"
msgid "Enable JIT for DSP LLE."
msgstr "Включить JIT для DSP LLE."

msgctxt "#30077"
msgid "Audio / DSP > Async Audio Callback"
msgstr "Аудио / DSP > Асинхронный звуковой обратный вызов"

msgctxt "#30078"
msgid "Use asynchronous audio callbacks."
msgstr "Использовать асинхронные звуковые обратные вызовы."

msgctxt "#30079"
msgid "Sync - Dolphin will push samples"
msgstr "Синхронно — Dolphin передаёт сэмплы"

msgctxt "#30080"
msgid "Sync - Per Frame using target refresh rate"
msgstr "Синхронно — покадрово с использованием целевой частоты обновления"

msgctxt "#30081"
msgid "Async - driven by callbacks using refresh rate and audio buffer status"
msgstr "Асинхронно — управляется обратными вызовами с учётом частоты обновления и состояния звукового буфера"

msgctxt "#30082"
msgid "Interface"
msgstr "Интерфейс"

msgctxt "#30083"
msgid "Configure on-screen display and logging."
msgstr "Настройка экранных сообщений и журналирования."

msgctxt "#30084"
msgid "Interface > On-Screen Display"
msgstr "Интерфейс > Экранные сообщения"

msgctxt "#30085"
msgid "Show OSD messages."
msgstr "Показывать экранные сообщения."

msgctxt "#30086"
msgid "Interface > Log Level"
msgstr "Интерфейс > Уровень журналирования"

msgctxt "#30087"
msgid "Set log verbosity."
msgstr "Задать подробность журнала."

msgctxt "#30088"
msgid "Notice"
msgstr "Уведомление"

msgctxt "#30089"
msgid "Error"
msgstr "Ошибка"

msgctxt "#30090"
msgid "Warning"
msgstr "Предупреждение"

msgctxt "#30091"
msgid "Info"
msgstr "Информация"

msgctxt "#30092"
msgid "Interface > Logging > Boot"
msgstr "Интерфейс > Журналирование > Загрузка"

msgctxt "#30093"
msgid "Enable Boot log messages."
msgstr "Включить сообщения журнала загрузки."

msgctxt "#30094"
msgid "Interface > Logging > Core"
msgstr "Интерфейс > Журналирование > Ядро"

msgctxt "#30095"
msgid "Enable Core log messages."
msgstr "Включить сообщения журнала ядра."

msgctxt "#30096"
msgid "Interface > Logging > Video"
msgstr "Интерфейс > Журналирование > Видео"

msgctxt "#30097"
msgid "Enable Video log messages."
msgstr "Включить сообщения журнала видео."

msgctxt "#30098"
msgid "Interface > Logging > Common"
msgstr "Интерфейс > Журналирование > Общие"

msgctxt "#30099"
msgid "Enable Common log messages."
msgstr "Включить общие сообщения журнала."

msgctxt "#30100"
msgid "Interface > Logging > Host GPU"
msgstr "Интерфейс > Журналирование > ГП хоста"

msgctxt "#30101"
msgid "Enable Host GPU log messages."
msgstr "Включить сообщения журнала ГП хоста."

msgctxt "#30102"
msgid "Interface > Logging > MemMap"
msgstr "Интерфейс > Журналирование > Карта памяти"

msgctxt "#30103"
msgid "Enable MemMap log messages."
msgstr "Включить сообщения журнала карты памяти."

msgctxt "#30104"
msgid "Interface > Logging > DSP Interface"
msgstr "Интерфейс > Журналирование > Интерфейс DSP"

msgctxt "#30105"
msgid "Enable DSP Interface log messages."
msgstr "Включить сообщения журнала интерфейса DSP."

msgctxt "#30106"
msgid "Interface > Logging > DSP HLE"
msgstr "Интерфейс > Журналирование > DSP HLE"

msgctxt "#30107"
msgid "Enable DSP HLE log messages."
msgstr "Включить сообщения журнала DSP HLE."

msgctxt "#30108"
msgid "Interface > Logging > DSP LLE"
msgstr "Интерфейс > Журналирование > DSP LLE"

msgctxt "#30109"
msgid "Enable DSP LLE log messages."
msgstr "Включить сообщения журнала DSP LLE."

msgctxt "#30110"
msgid "Interface > Logging > DSP MAIL"
msgstr "Интерфейс > Журналирование > DSP MAIL"

msgctxt "#30111"
msgid "Enable DSP MAIL log messages."
msgstr "Включить сообщения журнала DSP MAIL."

msgctxt "#30112"
msgid "Interface > Enable debugging"
msgstr "Интерфейс > Включить отладку"

msgctxt "#30113"
msgid "Enable the debugger."
msgstr "Включить отладчик."

msgctxt "#30114"
msgid "System Configuration - Gamecube"
msgstr "Конфигурация системы — GameCube"

msgctxt "#30115"
msgid "Configure Gamecube system settings."
msgstr "Настройка системных параметров GameCube."

msgctxt "#30116"
msgid "System Configuration (GC) > SP1 Device"
msgstr "Конфигурация системы (GC) > Устройство SP1"

msgctxt "#30117"
msgid "Select the device connected to the GameCube SP1 slot."
msgstr "Выберите устройство, подключённое к слоту SP1 GameCube."

msgctxt "#30118"
msgid "None"
msgstr "Нет"

msgctxt "#30119"
msgid "Dummy"
msgstr "Пустышка"

msgctxt "#30120"
msgid "Ethernet"
msgstr "Ethernet"

msgctxt "#30121"
msgid "Ethernet XLink"
msgstr "Ethernet XLink"

msgctxt "#30122"
msgid "Ethernet TapServer"
msgstr "Ethernet TapServer"

