msgctxt "#30256"
msgid "Sharp Bilinear"
msgstr "Резкий билинейный"

msgctxt "#30257"
msgid "Area Sampling"
msgstr "Площадная выборка"

msgctxt "#30258"
msgid "Graphics > Enhancements > Force True Color"
msgstr "Графика > Улучшения > Принудительный истинный цвет"

msgctxt "#30259"
msgid "Disable dithering and force 24-bit color output instead of 18-bit."
msgstr "Отключить дизеринг и принудительно использовать 24-битный цвет вместо 18-битного."

