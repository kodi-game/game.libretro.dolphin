msgid "60%"
msgstr "60%"

msgctxt "#30017"
msgid "70%"
msgstr "70%"

msgctxt "#30018"
msgid "80%"
msgstr "80%"

msgctxt "#30019"
msgid "90%"
msgstr "90%"

msgctxt "#30020"
msgid "100% (Default)"
msgstr "100% (výchozí)"

msgctxt "#30021"
msgid "150%"
msgstr "150%"

msgctxt "#30022"
msgid "200%"
msgstr "200%"

msgctxt "#30023"
msgid "250%"
msgstr "250%"

msgctxt "#30024"
msgid "300%"
msgstr "300%"

msgctxt "#30025"
msgid "Core > Emulation Speed"
msgstr "Jádro > Rychlost emulace"

msgctxt "#30026"
msgid "Set speed limit for emulation."
msgstr "Nastavit omezení rychlosti emulace."

msgctxt "#30027"
msgid "100% (Normal Speed)"
msgstr "100% (normální rychlost)"

msgctxt "#30028"
msgid "Unlimited"
msgstr "Bez omezení"

msgctxt "#30029"
msgid "Core > Dual Core Mode"
msgstr "Jádro > Dvoujádrový režim"

msgctxt "#30030"
msgid "Enable dual-core CPU emulation. Requires core RESTART."
msgstr "Povolit dvoujádrovou emulaci CPU. Vyžaduje RESTART jádra."

msgctxt "#30031"
msgid "Disabled"
msgstr "Zakázáno"

msgctxt "#30032"
msgid "Enabled"
msgstr "Povoleno"

msgctxt "#30033"
msgid "Core > Load Whole Game Into Memory"
msgstr "Jádro > Načíst celou hru do paměti"

msgctxt "#30034"
msgid "Load Whole Game Into Memory. Requires core RESTART."
msgstr "Načíst celou hru do paměti. Vyžaduje RESTART jádra."

msgctxt "#30035"
msgid "Core > Precision Frame Timing"
msgstr "Jádro > Přesné časování snímků"

msgctxt "#30036"
msgid "Use busy-wait for more accurate frame timing."
msgstr "Používat aktivní čekání pro přesnější časování snímků."

msgctxt "#30037"
msgid "Core > Fastmem"
msgstr "Jádro > Fastmem"

msgctxt "#30038"
msgid "Enable fastmem optimization - which uses memory mapping for faster access."
msgstr "Povolit optimalizaci fastmem - využívá mapování paměti pro rychlejší přístup."

msgctxt "#30039"
msgid "Core > Fastmem Arena"
msgstr "Jádro > Fastmem Arena"

msgctxt "#30040"
msgid "Enable fastmem arena - reserves 12 GiB of virtual memory for super fast access."
msgstr "Povolit arénu fastmem - vyhradí 12 GiB virtuální paměti pro mimořádně rychlý přístup."

msgctxt "#30041"
msgid "Core > Accurate CPU cache"
msgstr "Jádro > Přesná mezipaměť CPU"

msgctxt "#30042"
msgid "Enabled - fast, Disabled - guarantees correctness involving cache behaviour."
msgstr "Povoleno - rychlé, Zakázáno - zaručuje správnost chování mezipaměti."

msgctxt "#30043"
msgid "Core > Internal Cheats"
msgstr "Jádro > Interní cheaty"

msgctxt "#30044"
msgid "Enable built-in cheat codes. Restart core to take effect."
msgstr "Povolit vestavěné cheatovací kódy. Změna se projeví po restartu jádra."

msgctxt "#30045"
msgid "Core > Skip GameCube BIOS"
msgstr "Jádro > Přeskočit BIOS konzole GameCube"

msgctxt "#30046"
msgid "Skip the GameCube BIOS animation/menu and start the game directly."
msgstr "Přeskočit animaci/nabídku BIOS konzole GameCube a spustit hru přímo."

msgctxt "#30047"
msgid "Core > Disc Based Games Boot to Wii Menu"
msgstr "Jádro > Spouštět diskové hry do nabídky Wii"

msgctxt "#30048"
msgid "When a Wii System Menu is installed in the save location and the game is a disc based game, it will start the Wii Menu with the disc inserted in the drive instead of directly booting the game. Beware: The game region must match the Wii Menu region otherwise the game will not be recognized."
msgstr "Pokud je v umístění pro ukládání nainstalována systémová nabídka Wii a hra je na disku, spustí se nabídka Wii s diskem vloženým v mechanice místo přímého spuštění hry. Pozor: Region hry musí odpovídat regionu nabídky Wii, jinak nebude hra rozpoznána."

msgctxt "#30049"
msgid "Core > System Language"
msgstr "Jádro > Jazyk systému"

msgctxt "#30050"
msgid "Set system language."
msgstr "Nastavit jazyk systému."

msgctxt "#30051"
msgid "English"
msgstr "Angličtina"

msgctxt "#30052"
msgid "Japanese"
msgstr "Japonština"

msgctxt "#30053"
msgid "German"
msgstr "Němčina"

msgctxt "#30054"
msgid "French"
msgstr "Francouzština"

msgctxt "#30055"
msgid "Spanish"
msgstr "Španělština"

msgctxt "#30056"
msgid "Italian"
msgstr "Italština"

msgctxt "#30057"
msgid "Dutch"
msgstr "Nizozemština"

msgctxt "#30058"
msgid "Simplified Chinese"
msgstr "Zjednodušená čínština"

msgctxt "#30059"
msgid "Traditional Chinese"
msgstr "Tradiční čínština"

msgctxt "#30060"
msgid "Korean"
msgstr "Korejština"

msgctxt "#30061"
msgid "Core > Speed Up Disc Transfer"
msgstr "Jádro > Zrychlit přenos dat z disku"

msgctxt "#30062"
msgid "Reduce loading times."
msgstr "Zkrátit doby načítání."

msgctxt "#30063"
msgid "Core > Enable MMU"
msgstr "Jádro > Povolit MMU"

msgctxt "#30064"
msgid "Enable emulation of the Memory Management Unit."
msgstr "Povolit emulaci jednotky správy paměti."

msgctxt "#30065"
msgid "Core > Rush Frame Presentation"
msgstr "Jádro > Uspíšit prezentaci snímků"

msgctxt "#30066"
msgid "Enable rushing frame presentation for lower latency."
msgstr "Povolit uspíšení prezentace snímků pro nižší latenci."

msgctxt "#30067"
msgid "Core > Smooth Early Presentation"
msgstr "Jádro > Vyhladit předčasnou prezentaci"

msgctxt "#30068"
msgid "Enable smoother early frame presentation timing."
msgstr "Povolit plynulejší časování předčasné prezentace snímků."

msgctxt "#30069"
msgid "Audio / DSP"
msgstr "Zvuk / DSP"

msgctxt "#30070"
msgid "Configure audio output and DSP emulation."
msgstr "Nastavit zvukový výstup a emulaci DSP."

msgctxt "#30071"
msgid "Audio / DSP > DSP HLE"
msgstr "Zvuk / DSP > DSP HLE"

msgctxt "#30072"
msgid "Choose DSP method - HLE is faster, LLE is more accurate."
msgstr "Vybrat způsob emulace DSP - HLE je rychlejší, LLE je přesnější."

msgctxt "#30073"
msgid "HLE (Fast)"
msgstr "HLE (rychlé)"

msgctxt "#30074"
msgid "LLE (Accurate)"
msgstr "LLE (přesné)"

msgctxt "#30075"
msgid "Audio / DSP > DSP JIT"
msgstr "Zvuk / DSP > DSP JIT"

msgctxt "#30076"
msgid "Enable JIT for DSP LLE."
msgstr "Povolit JIT pro DSP LLE."

msgctxt "#30077"
msgid "Audio / DSP > Async Audio Callback"
msgstr "Zvuk / DSP > Asynchronní zpětné volání pro zvuk"

msgctxt "#30078"
msgid "Use asynchronous audio callbacks."
msgstr "Používat asynchronní zpětná volání pro zvuk."

msgctxt "#30079"
msgid "Sync - Dolphin will push samples"
msgstr "Synchronně - Dolphin bude odesílat vzorky"

msgctxt "#30080"
msgid "Sync - Per Frame using target refresh rate"
msgstr "Synchronně - pro každý snímek podle cílové obnovovací frekvence"

msgctxt "#30081"
msgid "Async - driven by callbacks using refresh rate and audio buffer status"
msgstr "Asynchronně - řízeno zpětnými voláními podle obnovovací frekvence a stavu zvukové vyrovnávací paměti"

msgctxt "#30082"
msgid "Interface"
msgstr "Rozhraní"

msgctxt "#30083"
msgid "Configure on-screen display and logging."
msgstr "Nastavit zobrazení na obrazovce a protokolování."

msgctxt "#30084"
msgid "Interface > On-Screen Display"
msgstr "Rozhraní > Zobrazení na obrazovce"

msgctxt "#30085"
msgid "Show OSD messages."
msgstr "Zobrazovat zprávy OSD."

msgctxt "#30086"
msgid "Interface > Log Level"
msgstr "Rozhraní > Úroveň protokolování"

msgctxt "#30087"
msgid "Set log verbosity."
msgstr "Nastavit podrobnost protokolování."

msgctxt "#30088"
msgid "Notice"
msgstr "Oznámení"

msgctxt "#30089"
msgid "Error"
msgstr "Chyba"

msgctxt "#30090"
msgid "Warning"
msgstr "Varování"

msgctxt "#30091"
msgid "Info"
msgstr "Informace"

msgctxt "#30092"
msgid "Interface > Logging > Boot"
msgstr "Rozhraní > Protokolování > Spouštění"

msgctxt "#30093"
msgid "Enable Boot log messages."
msgstr "Povolit protokolové zprávy o spouštění."

msgctxt "#30094"
msgid "Interface > Logging > Core"
msgstr "Rozhraní > Protokolování > Jádro"

msgctxt "#30095"
msgid "Enable Core log messages."
msgstr "Povolit protokolové zprávy jádra."

msgctxt "#30096"
msgid "Interface > Logging > Video"
msgstr "Rozhraní > Protokolování > Video"

msgctxt "#30097"
msgid "Enable Video log messages."
msgstr "Povolit protokolové zprávy videa."

msgctxt "#30098"
msgid "Interface > Logging > Common"
msgstr "Rozhraní > Protokolování > Obecné"

msgctxt "#30099"
msgid "Enable Common log messages."
msgstr "Povolit obecné protokolové zprávy."

msgctxt "#30100"
msgid "Interface > Logging > Host GPU"
msgstr "Rozhraní > Protokolování > Hostitelské GPU"

msgctxt "#30101"
msgid "Enable Host GPU log messages."
msgstr "Povolit protokolové zprávy hostitelského GPU."

msgctxt "#30102"
msgid "Interface > Logging > MemMap"
msgstr "Rozhraní > Protokolování > MemMap"

msgctxt "#30103"
msgid "Enable MemMap log messages."
msgstr "Povolit protokolové zprávy MemMap."

msgctxt "#30104"
msgid "Interface > Logging > DSP Interface"
msgstr "Rozhraní > Protokolování > Rozhraní DSP"

msgctxt "#30105"
msgid "Enable DSP Interface log messages."
msgstr "Povolit protokolové zprávy rozhraní DSP."

msgctxt "#30106"
msgid "Interface > Logging > DSP HLE"
msgstr "Rozhraní > Protokolování > DSP HLE"

msgctxt "#30107"
msgid "Enable DSP HLE log messages."
msgstr "Povolit protokolové zprávy DSP HLE."

msgctxt "#30108"
msgid "Interface > Logging > DSP LLE"
msgstr "Rozhraní > Protokolování > DSP LLE"

msgctxt "#30109"
msgid "Enable DSP LLE log messages."
msgstr "Povolit protokolové zprávy DSP LLE."

msgctxt "#30110"
msgid "Interface > Logging > DSP MAIL"
msgstr "Rozhraní > Protokolování > DSP MAIL"

msgctxt "#30111"
msgid "Enable DSP MAIL log messages."
msgstr "Povolit protokolové zprávy DSP MAIL."

msgctxt "#30112"
msgid "Interface > Enable debugging"
msgstr "Rozhraní > Povolit ladění"

msgctxt "#30113"
msgid "Enable the debugger."
msgstr "Povolit ladicí program."

msgctxt "#30114"
msgid "System Configuration - Gamecube"
msgstr "Nastavení systému - GameCube"

msgctxt "#30115"
msgid "Configure Gamecube system settings."
msgstr "Upravit systémová nastavení konzole GameCube."

msgctxt "#30116"
msgid "System Configuration (GC) > SP1 Device"
msgstr "Nastavení systému (GC) > Zařízení SP1"

msgctxt "#30117"
msgid "Select the device connected to the GameCube SP1 slot."
msgstr "Vybrat zařízení připojené do slotu SP1 konzole GameCube."

msgctxt "#30118"
msgid "None"
msgstr "Žádné"

msgctxt "#30119"
msgid "Dummy"
msgstr "Zástupné zařízení"

msgctxt "#30120"
msgid "Ethernet"
msgstr "Ethernet"

msgctxt "#30121"
msgid "Ethernet XLink"
msgstr "Ethernet XLink"

msgctxt "#30122"
msgid "Ethernet TapServer"
msgstr "Ethernet TapServer"

msgctxt "#30123"
msgid "Ethernet Built-In"
msgstr "Vestavěný Ethernet"

msgctxt "#30124"
msgid "Ethernet IPC"
msgstr "Ethernet IPC"

msgctxt "#30125"
msgid "Modem TapServer"
msgstr "Modem TapServer"

msgctxt "#30126"
msgid "Baseboard"
msgstr "Základní deska"

msgctxt "#30127"
msgid "System Configuration (GC) > GameCube Microphone"
msgstr "Nastavení systému (GC) > Mikrofon GameCube"

msgctxt "#30128"
msgid "Emulate the official GameCube microphone accessory. Restart core after changing this option."
msgstr "Emulovat oficiální mikrofonní příslušenství GameCube. Po změně této volby restartujte jádro."

msgctxt "#30129"
msgid "System Configuration (GC) > Microphone Button"
msgstr "Nastavení systému (GC) > Tlačítko mikrofonu"

msgctxt "#30130"
msgid "Button to hold or press to activate the microphone input. Selecting OFF disables microphone activation."
msgstr "Tlačítko, jehož podržením nebo stisknutím se aktivuje mikrofonní vstup. Výběrem možnosti „Zakázáno“ se aktivace mikrofonu zakáže."

msgctxt "#30131"
msgid "L3"
msgstr "L3"

msgctxt "#30132"
msgid "R3"
msgstr "R3"

msgctxt "#30133"
msgid "L1"
msgstr "L1"

msgctxt "#30134"
msgid "R1"
msgstr "R1"

msgctxt "#30135"
msgid "L2"
msgstr "L2"

