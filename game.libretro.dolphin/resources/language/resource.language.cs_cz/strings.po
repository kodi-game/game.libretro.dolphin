msgctxt "Addon Summary"
msgid "Nintendo - GameCube / Wii (Dolphin)"
msgstr "Nintendo - GameCube / Wii (Dolphin)"

msgctxt "Addon Description"
msgid "Dolphin is an emulator for two recent Nintendo video game consoles: the GameCube and the Wii."
msgstr "Dolphin je emulátor dvou novějších herních konzolí od společnosti Nintendo: GameCube a Wii."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Core"
msgstr "Jádro"

msgctxt "#30002"
msgid "Configure CPU emulation, timing, and core system settings."
msgstr "Nastavit emulaci CPU, časování a základní systémová nastavení."

msgctxt "#30003"
msgid "Core > CPU Core"
msgstr "Jádro > Jádro CPU"

msgctxt "#30004"
msgid "Select CPU emulation method - JIT provides best performance."
msgstr "Vybrat způsob emulace CPU - JIT poskytuje nejlepší výkon."

msgctxt "#30005"
msgid "Interpreter (slowest)"
msgstr "Interpret (nejpomalejší)"

msgctxt "#30006"
msgid "JIT64 (Recommended)"
msgstr "JIT64 (doporučeno)"

msgctxt "#30007"
msgid "Cached Interpreter (slower)"
msgstr "Interpret s mezipamětí (pomalejší)"

msgctxt "#30008"
msgid "Core > CPU Clock Rate"
msgstr "Jádro > Taktovací frekvence CPU"

msgctxt "#30009"
msgid "Adjust emulated CPU speed."
msgstr "Upravit rychlost emulovaného CPU."

msgctxt "#30010"
msgid "5%"
msgstr "5%"

msgctxt "#30011"
msgid "10%"
msgstr "10%"

msgctxt "#30012"
msgid "20%"
msgstr "20%"

msgctxt "#30013"
msgid "30%"
msgstr "30%"

msgctxt "#30014"
msgid "40%"
msgstr "40%"

msgctxt "#30015"
msgid "50%"
msgstr "50%"

