msgid "Start"
msgstr "Start"

msgctxt "#30142"
msgid "Select"
msgstr "Select"

msgctxt "#30143"
msgid "System Configuration - Wii"
msgstr "Nastavení systému - Wii"

msgctxt "#30144"
msgid "Configure Wii system settings."
msgstr "Upravit systémová nastavení konzole Wii."

msgctxt "#30145"
msgid "System Configuration > Widescreen (Wii)"
msgstr "Nastavení systému > Širokoúhlé zobrazení (Wii)"

msgctxt "#30146"
msgid "Enable widescreen for Wii."
msgstr "Povolit širokoúhlé zobrazení pro Wii."

msgctxt "#30147"
msgid "System Configuration > Progressive Scan"
msgstr "Nastavení systému > Progresivní rozklad"

msgctxt "#30148"
msgid "Enable progressive scan."
msgstr "Povolit progresivní rozklad."

msgctxt "#30149"
msgid "System Configuration > PAL60 Mode"
msgstr "Nastavení systému > Režim PAL60"

msgctxt "#30150"
msgid "Enable 60Hz for PAL games."
msgstr "Povolit 60 Hz pro hry PAL."

msgctxt "#30151"
msgid "System Configuration > Sensor Bar Position"
msgstr "Nastavení systému > Poloha senzorové lišty"

msgctxt "#30152"
msgid "Set Wiimote sensor bar position."
msgstr "Nastavit polohu senzorové lišty ovladače Wiimote."

msgctxt "#30153"
msgid "Bottom"
msgstr "Dole"

msgctxt "#30154"
msgid "Top"
msgstr "Nahoře"

msgctxt "#30155"
msgid "System Configuration > Controller Rumble"
msgstr "Nastavení systému > Vibrace ovladače"

msgctxt "#30156"
msgid "Enable rumble feedback."
msgstr "Povolit vibrační odezvu."

msgctxt "#30157"
msgid "System Configuration > Wiimote Continuous Scanning"
msgstr "Nastavení systému > Nepřetržité vyhledávání ovladačů Wiimote"

msgctxt "#30158"
msgid "Continuously scan for Wiimotes."
msgstr "Nepřetržitě vyhledávat ovladače Wiimote."

msgctxt "#30159"
msgid "System Configuration > Alt GC Ports (Wii)"
msgstr "Nastavení systému > Alternativní porty GC (Wii)"

msgctxt "#30160"
msgid "Use ports 5-8 for GameCube controllers in Wii mode."
msgstr "Používat porty 5-8 pro ovladače GameCube v režimu Wii."

msgctxt "#30161"
msgid "System Configuration > Bluetooth passthrough mode"
msgstr "Nastavení systému > Režim přímého předávání Bluetooth"

msgctxt "#30162"
msgid "Pass all traffic directly to the host's Bluetooth adapter. Press F12 to begin the sync process."
msgstr "Předávat veškerý provoz přímo adaptéru Bluetooth hostitelského systému. Stisknutím F12 zahájíte proces synchronizace."

msgctxt "#30163"
msgid "System Configuration > Wii Speak"
msgstr "Nastavení systému > Wii Speak"

msgctxt "#30164"
msgid "Emulate the Wii Speak microphone. Restart when changing this option."
msgstr "Emulovat mikrofon Wii Speak. Při změně této volby proveďte restart."

msgctxt "#30165"
msgid "Audio > Devices > Wii Speak Muted"
msgstr "Zvuk > Zařízení > Ztlumení Wii Speak"

msgctxt "#30166"
msgid "Mute or unmute the Wii Speak microphone."
msgstr "Ztlumit mikrofon Wii Speak nebo zrušit jeho ztlumení."

msgctxt "#30167"
msgid "System Configuration > Logitech USB Microphone"
msgstr "Nastavení systému > Mikrofon Logitech USB"

msgctxt "#30168"
msgid "Emulate the Logitech USB microphone. Restart when changing this option."
msgstr "Emulovat mikrofon Logitech USB. Při změně této volby proveďte restart."

msgctxt "#30169"
msgid "Graphics > Settings"
msgstr "Grafika > Nastavení"

msgctxt "#30170"
msgid "Configure rendering backend and quality settings."
msgstr "Nastavit vykreslovací backend a parametry kvality."

msgctxt "#30171"
msgid "Graphics > Settings > Graphics Backend"
msgstr "Grafika > Nastavení > Grafický backend"

msgctxt "#30172"
msgid "Select rendering backend."
msgstr "Vybrat vykreslovací backend."

msgctxt "#30173"
msgid "Hardware"
msgstr "Hardwarový"

msgctxt "#30174"
msgid "Graphics > Settings > Widescreen Hack"
msgstr "Grafika > Nastavení > Hack pro širokoúhlé zobrazení"

msgctxt "#30175"
msgid "Force 16:9 rendering."
msgstr "Vynutit vykreslování v poměru 16:9."

msgctxt "#30176"
msgid "Graphics > Settings > Aspect Ratio"
msgstr "Grafika > Nastavení > Poměr stran"

msgctxt "#30177"
msgid "Control how the game's image is scaled."
msgstr "Určit způsob škálování obrazu hry."

msgctxt "#30178"
msgid "Auto"
msgstr "Automaticky"

msgctxt "#30179"
msgid "Force Wide"
msgstr "Vynutit širokoúhlý poměr"

msgctxt "#30180"
msgid "Force Standard"
msgstr "Vynutit standardní poměr"

msgctxt "#30181"
msgid "Stretch"
msgstr "Roztáhnout"

msgctxt "#30182"
msgid "Custom"
msgstr "Vlastní"

msgctxt "#30183"
msgid "Custom Stretch"
msgstr "Vlastní roztažení"

msgctxt "#30184"
msgid "Raw"
msgstr "Neupravený"

msgctxt "#30185"
msgid "Graphics > Settings > Crop Overscan"
msgstr "Grafika > Nastavení > Oříznout přesah obrazu"

msgctxt "#30186"
msgid "Report standard TV output resolution to the frontend (NTSC: 480, PAL: 576). Recommended for CRT displays with SwitchRes."
msgstr "Hlásit frontendu standardní výstupní rozlišení TV (NTSC: 480, PAL: 576). Doporučeno pro obrazovky CRT se SwitchRes."

msgctxt "#30187"
msgid "Graphics > Settings > Internal Resolution"
msgstr "Grafika > Nastavení > Interní rozlišení"

msgctxt "#30188"
msgid "Multiply native resolution."
msgstr "Násobit nativní rozlišení."

msgctxt "#30189"
msgid "1x Native (640x528)"
msgstr "1x nativní (640x528)"

msgctxt "#30190"
msgid "2x Native (1280x1056) for 720p"
msgstr "2x nativní (1280x1056) pro 720p"

msgctxt "#30191"
msgid "3x Native (1920x1584) for 1080p"
msgstr "3x nativní (1920x1584) pro 1080p"

msgctxt "#30192"
msgid "4x Native (2560x2112) for 1440p"
msgstr "4x nativní (2560x2112) pro 1440p"

msgctxt "#30193"
msgid "5x Native (3200x2640)"
msgstr "5x nativní (3200x2640)"

msgctxt "#30194"
msgid "6x Native (3840x3168) for 4K"
msgstr "6x nativní (3840x3168) pro 4K"

msgctxt "#30195"
msgid "7x Native (4480x3696)"
msgstr "7x nativní (4480x3696)"

msgctxt "#30196"
msgid "8x Native (5120x4224) for 5K"
msgstr "8x nativní (5120x4224) pro 5K"

msgctxt "#30197"
msgid "9x Native (5760x4752)"
msgstr "9x nativní (5760x4752)"

msgctxt "#30198"
msgid "10x Native (6400x5280)"
msgstr "10x nativní (6400x5280)"

msgctxt "#30199"
msgid "11x Native (7040x5808)"
