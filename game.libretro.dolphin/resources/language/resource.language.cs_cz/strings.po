msgctxt "#30477"
msgid "Wiimote IR > Wiimote IR Total Pitch"
msgstr "Wiimote IR > Celkový úhel klopení Wiimote IR"

msgctxt "#30478"
msgid "Vertical field of view for Wiimote pointer."
msgstr "Svislé zorné pole ukazatele Wiimote."

msgctxt "#30479"
msgid "Wiimote IR > Wiimote IR Deadzone"
msgstr "Wiimote IR > Mrtvá zóna Wiimote IR"

msgctxt "#30480"
msgid "Amount of small IR‑cursor movement to ignore (0–50%)."
msgstr "Rozsah drobných pohybů IR kurzoru, které se mají ignorovat (0–50%)."

msgctxt "#30481"
msgid "0% (No Deadzone)"
msgstr "0% (bez mrtvé zóny)"

msgctxt "#30482"
msgid "WiiMote IR > Modifier Button"
msgstr "Wiimote IR > Modifikační tlačítko"

msgctxt "#30483"
msgid "Button used as a modifier for IR control. With no modifier selected, IR is always active with right thumbstick."
msgstr "Tlačítko používané jako modifikátor pro ovládání IR. Pokud není vybrán žádný modifikátor, je ovládání IR pravou páčkou vždy aktivní."

msgctxt "#30484"
msgid "None (Default)"
msgstr "Žádné (výchozí)"

msgctxt "#30485"
msgid "WiiMote Swing > Modifier Button"
msgstr "Wiimote švih > Modifikační tlačítko"

msgctxt "#30486"
msgid "Button to hold while using right thumbstick to activate swing. OFF turns off swing. Selecting none will allow free use of right thumb stick to swing (It will automatically filter out L3)."
msgstr "Tlačítko, které je třeba držet při použití pravé páčky k aktivaci švihu. Volba „Zakázáno“ švih vypne. Volba „Žádné“ umožní volně používat pravou páčku ke švihu (L3 se automaticky odfiltruje)."

msgctxt "#30487"
msgid "Wiimote Swing > Angle"
msgstr "Wiimote švih > Úhel"

msgctxt "#30488"
msgid "Rotation applied at the extremities of a swing (1-180°)."
msgstr "Otočení použité v krajních polohách švihu (1-180°)."

msgctxt "#30489"
msgid "90° (Default)"
msgstr "90° (výchozí)"

